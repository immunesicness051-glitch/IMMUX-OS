#!/usr/bin/env python3
"""
Immux-OS Network Initialization & Security Boundary Engine
Handles cross-environment bridge setups, nftables generation, 
live packet telemetry, and DNS-based system-wide ad blocking.
"""

import os
import sys
import subprocess
import json

CONFIG_PATH = "/etc/immux/network.json"
ADBLOCK_HOSTS_URL = "https://githubusercontent.com"
ADBLOCK_LOCAL_FILE = "/etc/immux/adblock.hosts"

DEFAULT_CONFIG = {
    "system_wide_adblock": True,
    "isolated_sysroot_boundary": True,
    "wayland_routing_port": 6000,
    "environments": {
        "alpine_core": "10.0.5.1/24",
        "arch_userland": "10.0.5.2/24",
        "termux_bridge": "10.0.5.3/24",
        "android_apk_bridge": "10.0.5.4/24"
    }
}

def load_config():
    if not os.path.exists(CONFIG_PATH):
        os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
        with open(CONFIG_PATH, 'w') as f:
            json.dump(DEFAULT_CONFIG, f, indent=4)
        return DEFAULT_CONFIG
    with open(CONFIG_PATH, 'r') as f:
        return json.load(f)

def run_cmd(cmd):
    try:
        res = subprocess.run(cmd, shell=True, check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        return res.stdout.decode().strip()
    except subprocess.CalledProcessError as e:
        print(f"[-] Error executing: {cmd}\nStderr: {e.stderr.decode().strip()}", file=sys.stderr)
        return None

def init_network_bridges():
    print("[+] Initializing cross-environment internal veth interfaces...")
    run_cmd("ip link add immux-br0 type bridge 2>/dev/null || true")
    run_cmd("ip link set immux-br0 up")
    run_cmd("ip addr add 10.0.5.254/24 dev immux-br0 2>/dev/null || true")

def configure_nftables(config):
    print("[+] Compiling and enforcing nftables isolation structures...")
    
    nft_rules = [
        "flush ruleset",
        "table inet immux_filter {",
        "    chain input {",
        "        type filter hook input priority filter; policy accept;",
        "    }",
        "    chain forward {",
        "        type filter hook forward priority filter; policy drop;",
    ]
    
    # Secure /sysroot and cross-container isolation bounds
    if config.get("isolated_sysroot_boundary"):
        nft_rules.extend([
            "        # Prevent unauthorized packet traversal into system storage networks",
            "        ip saddr { 10.0.5.0/24 } ip daddr 10.0.5.254 tcp dport 22 drop",
            "        ip saddr { 10.0.5.240/28 } drop # Isolated environment subnet restrictions"
        ])
        
    nft_rules.extend([
        "        # Allow verified multi-environment cross-communication",
        "        ip saddr 10.0.5.0/24 ip daddr 10.0.5.0/24 accept",
        "    }",
        "    chain output {",
        "        type filter hook output priority filter; policy accept;",
        "    }",
        "}"
    ])
    
    # Save ruleset
    rules_str = "\n".join(nft_rules)
    with open("/etc/nftables.immux.rules", "w") as f:
        f.write(rules_str)
        
    run_cmd("nft -f /etc/nftables.immux.rules")
    print("[+] Active network security policy synchronized successfully.")

def setup_ad_blocking(config):
    if not config.get("system_wide_adblock"):
        print("[*] System-wide ad-blocking disabled via profile configurations.")
        run_cmd("sed -i '/# IMMUX-ADBLOCK-START/,/# IMMUX-ADBLOCK-END/d' /etc/hosts")
        return

    print("[+] Loading local ad-blocking filters into network routing loop...")
    if not os.path.exists(ADBLOCK_LOCAL_FILE):
        # Fallback local mini-blacklist if internet is unreachable during initial boot bootstrap
        fallback_hosts = "127.0.0.1 doubleclick.net\n127.0.0.1 googleads.g.doubleclick.net\n"
        with open(ADBLOCK_LOCAL_FILE, "w") as f:
            f.write(fallback_hosts)
            
    # Append rules cleanly to system configuration mapping
    with open(ADBLOCK_LOCAL_FILE, "r") as f:
        adblock_data = f.read()
        
    run_cmd("sed -i '/# IMMUX-ADBLOCK-START/,/# IMMUX-ADBLOCK-END/d' /etc/hosts")
    
    with open("/etc/hosts", "a") as f:
        f.write("\n# IMMUX-ADBLOCK-START\n")
        f.write(adblock_data)
        f.write("\n# IMMUX-ADBLOCK-END\n")
    print("[+] Global network layout updated with DNS blackhole mapping hooks.")

if __name__ == "__main__":
    if os.geteuid() != 0:
        print("[-] Immux network orchestration utilities require root privileges.")
        sys.exit(1)
        
    cfg = load_config()
    init_network_bridges()
    configure_nftables(cfg)
    setup_ad_blocking(cfg)
    print("[+] Immux-OS Network Initialization Layer Fully Running.")
